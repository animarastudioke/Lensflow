# =============================================================================
# LENSFLOW - Environment Variables
# =============================================================================
# Copy this file to .env.local and fill in your values
# Never commit .env.local to version control
# =============================================================================

# -----------------------------------------------------------------------------
# APPLICATION
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_NAME="LensFlow"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_DESCRIPTION="Premium SaaS platform for photographers and videographers"
NEXT_PUBLIC_APP_KEYWORDS="photography, videography, client galleries, photo delivery, studio management"

# -----------------------------------------------------------------------------
# SUPABASE (Database, Auth, Storage, Realtime)
# -----------------------------------------------------------------------------
# Get these from your Supabase project settings: https://supabase.com/dashboard
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
SUPABASE_JWT_SECRET="your-jwt-secret"

# -----------------------------------------------------------------------------
# SUPABASE STORAGE
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_STORAGE_URL="https://your-project.supabase.co/storage/v1"
SUPABASE_STORAGE_BUCKET_PRIVATE="private"
SUPABASE_STORAGE_BUCKET_PUBLIC="public"
SUPABASE_STORAGE_BUCKET_TEMP="temp"

# -----------------------------------------------------------------------------
# AUTHENTICATION
# -----------------------------------------------------------------------------
# Supabase Auth providers (enable in Supabase dashboard)
# Email/Password: enabled by default
# OAuth providers: Google, GitHub, Apple, etc.
NEXT_PUBLIC_AUTH_SITE_URL="http://localhost:3000"
AUTH_REDIRECT_URL="http://localhost:3000/auth/callback"
AUTH_EMAIL_CONFIRM_REDIRECT="http://localhost:3000/auth/confirmed"

# -----------------------------------------------------------------------------
# EMAIL (Resend)
# -----------------------------------------------------------------------------
# Get API key from: https://resend.com/api-keys
RESEND_API_KEY="re_123456789"
RESEND_FROM_EMAIL="LensFlow <noreply@yourdomain.com>"
RESEND_FROM_NAME="LensFlow"
RESEND_REPLY_TO="support@yourdomain.com"

# -----------------------------------------------------------------------------
# SMS/WhatsApp (Africa's Talking)
# -----------------------------------------------------------------------------
# Get credentials from: https://africastalking.com
AFRICASTALKING_USERNAME="your-username"
AFRICASTALKING_API_KEY="your-api-key"
AFRICASTALKING_SENDER_ID="LensFlow"
AFRICASTALKING_SHORTCODE="12345"

# -----------------------------------------------------------------------------
# PAYMENTS - STRIPE
# -----------------------------------------------------------------------------
# Get keys from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY="sk_test_123456789"
STRIPE_PUBLISHABLE_KEY="pk_test_123456789"
STRIPE_WEBHOOK_SECRET="whsec_123456789"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_123456789"

# -----------------------------------------------------------------------------
# PAYMENTS - FLUTTERWAVE
# -----------------------------------------------------------------------------
# Get keys from: https://dashboard.flutterwave.com
FLUTTERWAVE_SECRET_KEY="FLWSECK_TEST-123456789-X"
FLUTTERWAVE_PUBLIC_KEY="FLWPUBK_TEST-123456789-X"
FLUTTERWAVE_ENCRYPTION_KEY="FLWSECK_TEST123456789X"
FLUTTERWAVE_WEBHOOK_HASH="your-webhook-hash"

# -----------------------------------------------------------------------------
# PAYMENTS - M-PESA (Safaricom)
# -----------------------------------------------------------------------------
# Get credentials from: https://developer.safaricom.co.ke
MPESA_CONSUMER_KEY="your-consumer-key"
MPESA_CONSUMER_SECRET="your-consumer-secret"
MPESA_SHORTCODE="123456"
MPESA_PASSKEY="your-passkey"
MPESA_ENVIRONMENT="sandbox"
MPESA_CALLBACK_URL="http://localhost:3000/api/payments/mpesa/callback"

# -----------------------------------------------------------------------------
# PAYMENTS - PAYPAL
# -----------------------------------------------------------------------------
# Get credentials from: https://developer.paypal.com
PAYPAL_CLIENT_ID="your-client-id"
PAYPAL_CLIENT_SECRET="your-client-secret"
PAYPAL_ENVIRONMENT="sandbox"
PAYPAL_WEBHOOK_ID="your-webhook-id"

# -----------------------------------------------------------------------------
# CURRENCY & LOCALIZATION
# -----------------------------------------------------------------------------
DEFAULT_CURRENCY="USD"
SUPPORTED_CURRENCIES="USD,KES,NGN,ZAR,GHS,UGX,TZS,RWF,XOF,XAF"
NEXT_PUBLIC_DEFAULT_LOCALE="en"
NEXT_PUBLIC_SUPPORTED_LOCALES="en,sw,fr,pt,ar"

# -----------------------------------------------------------------------------
# ANALYTICS (PostHog)
# -----------------------------------------------------------------------------
# Get API key from: https://posthog.com
NEXT_PUBLIC_POSTHOG_KEY="phc_123456789"
NEXT_PUBLIC_POSTHOG_HOST="https://eu.i.posthog.com"

# -----------------------------------------------------------------------------
# ERROR TRACKING (Sentry)
# -----------------------------------------------------------------------------
# Get DSN from: https://sentry.io
SENTRY_DSN="https://123456789@o123456.ingest.sentry.io/123456"
SENTRY_ORG="your-org"
SENTRY_PROJECT="lensflow"
SENTRY_AUTH_TOKEN="your-auth-token"

# -----------------------------------------------------------------------------
# FEATURE FLAGS
# -----------------------------------------------------------------------------
NEXT_PUBLIC_ENABLE_BETA_FEATURES="false"
NEXT_PUBLIC_ENABLE_ANALYTICS="true"
NEXT_PUBLIC_ENABLE_NOTIFICATIONS="true"
NEXT_PUBLIC_ENABLE_DARK_MODE="true"

# -----------------------------------------------------------------------------
# UPLOAD SETTINGS
# -----------------------------------------------------------------------------
MAX_FILE_SIZE="52428800"
MAX_VIDEO_SIZE="1073741824"
CHUNK_SIZE="5242880"
ALLOWED_IMAGE_TYPES="image/jpeg,image/png,image/tiff,image/webp,image/heic,image/avif"
ALLOWED_VIDEO_TYPES="video/mp4,video/quicktime,video/x-matroska,video/webm"
ALLOWED_RAW_EXTENSIONS=".cr2,.cr3,.nef,.nrw,.arw,.rw2,.orf,.raf,.dng,.pef,.srw,.x3f,.mef,.mos,.mrw,.raw,.rwl,.dcr,.k25,.kdc,.erf,.fff,.iiq,.3fr,.cap"

# -----------------------------------------------------------------------------
# DEVELOPMENT
# -----------------------------------------------------------------------------
NODE_ENV="development"
NEXT_TELEMETRY_DISABLED="1"